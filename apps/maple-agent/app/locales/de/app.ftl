## Parameterized Settings messages
# $name is an MCP server name typed by the user.
settings-server-exists = Ein Server namens { $name } ist bereits vorhanden
# $message is an untranslated diagnostic.
settings-shortcut-change-failed = Tastenkürzeländerung fehlgeschlagen: { $message }
# $message is an untranslated diagnostic.
settings-shortcut-invalid = Dieses Tastenkürzel kann nicht verwendet werden: { $message }
# $binding-count is the number of shortcuts; $modified-count is how many were changed.
settings-shortcut-counts = { $binding-count } Zuweisungen · { $modified-count } geändert
# $error is an untranslated diagnostic.
settings-shortcut-overrides-invalid = Gespeicherte Tastenkürzelanpassungen wurden nicht übernommen; Maple hat die vollständige Standardbelegung beibehalten. { $error }
# $modified-count is the number of changed shortcuts.
settings-shortcut-reset-confirm = Alle { $modified-count } Tastenkürzeländerungen zurücksetzen?
# $label is the translated name of the shortcut being recorded.
settings-shortcut-recording = Aufzeichnung: { $label }
# $conflict is a translated description of the conflict; $other is the translated name of the other shortcut; $slot-id is its internal ID, not translated.
settings-shortcut-collision = { $conflict } mit { $other } ({ $slot-id })
# $count is the number of conflicts.
settings-shortcut-conflicts = Tastenkürzelkonflikte: { $count }
# $shortcut is a key sequence, not translated.
settings-shortcut-default = Standard: { $shortcut }
# $computer is the start of a computer ID, not translated.
settings-execution-computer = Ausführender Computer: { $computer }. Systemeigene Einrichtung und Berechtigungen müssen dort abgeschlossen werden.
# $version is a version number.
settings-integration-version = Version { $version }
# $percent is a number from 0 to 100.
settings-usage-percent = { $percent } % genutzt
# $reset is a formatted date or a phrase such as "in 3 days".
settings-usage-resets = · Zurücksetzung: { $reset }
# $delete-acknowledgement is the exact text to type, not translated.
settings-delete-confirmation = Gib zur Bestätigung { $delete-acknowledgement } ein
