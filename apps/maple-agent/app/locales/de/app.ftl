settings-credits-balance = { $credits } Guthabenpunkte
# $credits is a formatted number; $dollars is a whole dollar amount.
settings-credits-cost = { $credits } Guthabenpunkte für { $dollars } $
# $name is an API key name typed by the user.
settings-api-key-ready = „{ $name }“ ist bereit
# $date is a formatted date.
settings-api-key-created = Erstellt am { $date }
# $count is the number of requests in progress.
settings-local-api-requests = { $count ->
    [one] { $count } aktive Anfrage
   *[other] { $count } aktive Anfragen
    }
# $name is an MCP setting name, not translated.
settings-mcp-secret-required = Gib einen neuen Wert für { $name } ein oder wähle „Löschen“.
