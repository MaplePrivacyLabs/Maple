## Parameterized Settings messages
# $name is an MCP server name typed by the user.
settings-server-exists = 같은 이름의 서버가 이미 있어요: { $name }
# $message is an untranslated diagnostic.
settings-shortcut-change-failed = 단축키를 변경하지 못했어요: { $message }
# $message is an untranslated diagnostic.
settings-shortcut-invalid = 이 단축키는 사용할 수 없어요: { $message }
# $binding-count is the number of shortcuts; $modified-count is how many were changed.
settings-shortcut-counts = 단축키 { $binding-count }개 · { $modified-count }개 수정됨
# $error is an untranslated diagnostic.
settings-shortcut-overrides-invalid = 저장된 단축키 재정의가 적용되지 않아서 Maple이 기본 단축키 전체를 유지했어요. { $error }
# $modified-count is the number of changed shortcuts.
settings-shortcut-reset-confirm = 단축키 변경 사항 { $modified-count }개를 모두 재설정할까요?
# $label is the translated name of the shortcut being recorded.
settings-shortcut-recording = 기록 중: { $label }
# $conflict is a translated description of the conflict; $other is the translated name of the other shortcut; $slot-id is its internal ID, not translated.
settings-shortcut-collision = { $conflict }: { $other } ({ $slot-id })
# $count is the number of conflicts.
settings-shortcut-conflicts = 단축키 충돌: { $count }
# $shortcut is a key sequence, not translated.
settings-shortcut-default = 기본값: { $shortcut }
# $computer is the start of a computer ID, not translated.
settings-execution-computer = 실행 컴퓨터: { $computer }. 네이티브 설정과 권한 부여는 해당 컴퓨터에서 완료해야 해요.
# $version is a version number.
settings-integration-version = 버전 { $version }
# $percent is a number from 0 to 100.
settings-usage-percent = { $percent }% 사용
# $reset is a formatted date or a phrase such as "in 3 days".
settings-usage-resets = · 초기화: { $reset }
# $delete-acknowledgement is the exact text to type, not translated.
settings-delete-confirmation = 확인하려면 { $delete-acknowledgement } 입력
# $min-credit-purchase-dollars and $max-credit-purchase-dollars are whole dollar amounts.
settings-credits-amount-placeholder = 달러 금액, ${ $min-credit-purchase-dollars }~${ $max-credit-purchase-dollars }
# $credits is a formatted number.
settings-credits-balance = { $credits } 크레딧
# $credits is a formatted number; $dollars is a whole dollar amount.
settings-credits-cost = { $credits } 크레딧 · ${ $dollars }
# $name is an API key name typed by the user.
settings-api-key-ready = “{ $name }” 키가 준비됐어요
# $date is a formatted date.
settings-api-key-created = 생성일: { $date }
# $count is the number of requests in progress.
settings-local-api-requests = 활성 요청 { $count }개
# $name is an MCP setting name, not translated.
settings-mcp-secret-required = { $name }의 새 값을 입력하거나 '지우기'를 선택하세요.
# $id is the first eight characters of a computer ID, not translated.
settings-computer-name = 컴퓨터 { $id }
# $client is a version number.
settings-remote-client-version = 이 컴퓨터는 v{ $client } 버전을 실행 중이에요.
# $running is the formatted version that computer runs; $activity is a translated status.
settings-remote-checking = { $running } · { $activity }
# $running is the formatted version that computer runs.
settings-remote-last-seen = { $running } (마지막 확인 시점)
# $running is the formatted version that computer runs; $target is the version on offer.
settings-remote-update-available = { $running } · { $target } 사용 가능
# $running is the formatted version that computer runs; $target is the version being downloaded.
settings-remote-downloading-version = { $running } · { $target } 다운로드 중…
# $running is the formatted version that computer runs.
settings-remote-downloading = { $running } · 다운로드 중…
# $running is the formatted version that computer runs.
settings-remote-checking-updates = { $running } · 업데이트 확인 중…
# $running is the formatted version that computer runs.
settings-remote-updating-status = { $running } · 업데이트 중…
# $running is the formatted version that computer runs.
settings-remote-restart-needed-status = { $running } · 해당 컴퓨터에서 다시 시작 필요
# $running is the formatted version that computer runs.
settings-remote-sending-update = { $running } · 업데이트 보내는 중…
# $running is the formatted version that computer runs; $target is the version being installed.
settings-remote-updating-version = { $running } · { $target } 버전으로 업데이트 중…
# $target is the installed version.
settings-remote-updated = { $target } 버전으로 업데이트했어요.
# $target is the version that did not finish installing.
settings-remote-update-incomplete = { $target } 버전으로의 업데이트가 완료되지 않았어요.
# $name is a computer name; $version is the target version.
settings-remote-update-confirm-title = { $name } 컴퓨터를 { $version } 버전으로 업데이트할까요?
# $name is a computer name.
settings-remote-update-action = { $name } 업데이트
# $name is a computer name; $version is the target version; $client-version is the version on this computer.
settings-remote-update-confirm-detail = { $name } 컴퓨터가 실행 중인 작업을 중지하고 { $version } 버전을 설치한 후 다시 시작해요. 원격 접근이 복구되지 않을 수 있으며, 그런 경우 { $name } 컴퓨터에서 직접 Maple을 여세요. 이 컴퓨터는 v{ $client-version } 버전으로 유지되며 다시 시작되지 않아요.
# $minutes and $seconds are the time left, shown as M:SS.
settings-pairing-expiry = 1회 시도 가능 · { $minutes }:{ $seconds } 후 만료
# $name is a computer name.
settings-computer-options = { $name } 옵션

