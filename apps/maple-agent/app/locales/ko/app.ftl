    [1] { $a }가 있어요. 종료하면 호스트{ $api } 중지 후 Maple을 닫아요.
    [2] { $a }, { $b }가 있어요. 종료하면 호스트{ $api } 중지 후 Maple을 닫아요.
    [3] { $a }, { $b }, { $c }가 있어요. 종료하면 호스트{ $api } 중지 후 Maple을 닫아요.
    [4] { $a }, { $b }, { $c }, { $d }가 있어요. 종료하면 호스트{ $api } 중지 후 Maple을 닫아요.
    [5] { $a }, { $b }, { $c }, { $d }, { $e }가 있어요. 종료하면 호스트{ $api } 중지 후 Maple을 닫아요.
   *[0] 종료하면 호스트{ $api } 중지 후 Maple을 닫아요.
}
# The $api clause of native-quit-activity.
native-quit-api-clause = (로컬 API 포함)
# $version is the app version; $status is the localized updater status.
native-about-details = 버전 { $version }
    { $status }
