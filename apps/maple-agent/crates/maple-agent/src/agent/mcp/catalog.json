  {
    "id": "playwright",
    "registry": "com.microsoft/playwright-mcp",
    "name": "Playwright",
    "summary": "Browse websites, click through pages and fill in forms",
    "category": "developer",
    "connect": {
      "type": "package",
      "registryType": "npm",
      "identifier": "@playwright/mcp",
      "version": "0.0.83",
      "arguments": [
        "--isolated",
        "--output-dir",
        "~/.cache/maple/playwright"
      ]
    },
    "auth": {
      "kind": "none"
    },
    "requires": [
      {
        "name": "Node.js",
        "check": [
          "node",
          "--version"
        ],
        "minVersion": "18",
        "getUrl": "https://nodejs.org/en/download"
      }
    ],
    "help": "Playwright could not start. Check that Chrome is installed, then try again."
  },
  {
    "id": "xcode",
    "name": "Xcode",
    "summary": "Build and test your Xcode projects",
    "category": "developer",
    "connect": {
      "type": "command",
      "command": "xcrun",
      "arguments": [
        "mcpbridge"
      ]
    },
    "auth": {
      "kind": "none"
    },
    "platforms": [
      "macos"
    ],
    "requires": [
      {
        "name": "Xcode",
        "check": [
          "xcode-select",
          "-p"
        ],
        "getUrl": "https://apps.apple.com/app/xcode/id497799835"
      },
      {
        "name": "a newer Xcode",
        "check": [
          "xcrun",
          "--find",
          "mcpbridge"
        ],
        "getUrl": "https://apps.apple.com/app/xcode/id497799835"
      }
    ],
    "connectSeconds": 30,
    "help": "Open Xcode, then allow external agents in Settings > Intelligence."
  }
]
