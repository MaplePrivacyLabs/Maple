{
  "name": "@trymaple/updates-worker",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.5",
  "scripts": {
    "check": "bun run format:check && bun run typecheck && bun run test && bun run build:dry-run",
    "build:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "prettier --write \"src/**/*.ts\" README.md package.json tsconfig.json wrangler.jsonc",
    "format:check": "prettier --check \"src/**/*.ts\" README.md package.json tsconfig.json wrangler.jsonc",
    "test": "bun --no-env-file test",
    "typecheck": "tsc --noEmit",
    "validate:latest": "bun src/validate-latest.ts",
    "prepare:installers": "bun src/prepare-installers.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "wrangler": "4.125.0"
  }
}
